<div class="wod-header-fields">
  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.name"}}:</label>
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize "system.sheet.name"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.sheet.player"}}:</label>
      <input type="text" name="systemData.profile.player" value="{{system.profile.player}}" placeholder="{{localize "system.sheet.player"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.sheet.chronicle"}}:</label>
      <input type="text" name="systemData.profile.chronicle" value="{{system.profile.chronicle}}" placeholder="{{localize "system.sheet.chronicle"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.hunter.creed"}} / Credo:</label>
      <input type="text" name="systemData.profile.creed" value="{{system.profile.creed}}" placeholder="Defensor, Juiz, Vingador, Redentor..." />
    </div>
    <div class="wod-field">
      <label>{{localize "system.sheet.nature"}}:</label>
      <input type="text" name="systemData.profile.nature" value="{{system.profile.nature}}" placeholder="{{localize "system.sheet.nature"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.sheet.demeanor"}}:</label>
      <input type="text" name="systemData.profile.demeanor" value="{{system.profile.demeanor}}" placeholder="{{localize "system.sheet.demeanor"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.hunter.profession"}} / Ocupação:</label>
      <input type="text" name="systemData.profile.profession" value="{{system.profile.profession}}" placeholder="Detetive, Médico, Jornalista..." />
    </div>
    <div class="wod-field">
      <label>{{localize "system.hunter.cell"}} / Célula / Afiliação:</label>
      <input type="text" name="systemData.profile.affiliation" value="{{system.profile.affiliation}}" placeholder="Sociedade de Leopoldo, Célula Local..." />
    </div>
    <div class="wod-field">
      <label>{{localize "system.sheet.concept"}}:</label>
      <input type="text" name="systemData.profile.concept" value="{{system.profile.concept}}" placeholder="{{localize "system.sheet.concept"}}" />
    </div>
  </div>
</div>
