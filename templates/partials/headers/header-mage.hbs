<div class="wod-header-fields">
  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.name"}}:</label>
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize "system.sheet.name"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.mage.essence"}}:</label>
      <input type="text" name="systemData.profile.essence" value="{{system.profile.essence}}" placeholder="{{localize "system.mage.essence"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.mage.tradition"}}:</label>
      <input type="text" name="systemData.profile.tradition" value="{{system.profile.tradition}}" placeholder="{{localize "system.mage.tradition"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.player"}}:</label>
      <input type="text" name="systemData.profile.player" value="{{system.profile.player}}" placeholder="{{localize "system.sheet.player"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.mage.affiliation"}}:</label>
      <input type="text" name="systemData.profile.affiliation" value="{{system.profile.affiliation}}" placeholder="{{localize "system.mage.affiliation"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.mage.cabal"}}:</label>
      <input type="text" name="systemData.profile.cabal" value="{{system.profile.cabal}}" placeholder="{{localize "system.mage.cabal"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.chronicle"}}:</label>
      <input type="text" name="systemData.profile.chronicle" value="{{system.profile.chronicle}}" placeholder="{{localize "system.sheet.chronicle"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.sheet.concept"}}:</label>
      <input type="text" name="systemData.profile.concept" value="{{system.profile.concept}}" placeholder="{{localize "system.sheet.concept"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.mage.sect"}}:</label>
      <input type="text" name="systemData.profile.sect" value="{{system.profile.sect}}" placeholder="{{localize "system.mage.sect"}}" />
    </div>
  </div>
</div>
