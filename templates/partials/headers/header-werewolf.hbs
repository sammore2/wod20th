<div class="wod-header-fields">
  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.name"}}:</label>
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize "system.sheet.name"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.werewolf.breed"}}:</label>
      <input type="text" name="systemData.profile.breed" value="{{system.profile.breed}}" placeholder="{{localize "system.werewolf.breed"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.werewolf.auspice"}}:</label>
      <input type="text" name="systemData.profile.auspice" value="{{system.profile.auspice}}" placeholder="{{localize "system.werewolf.auspice"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.player"}}:</label>
      <input type="text" name="systemData.profile.player" value="{{system.profile.player}}" placeholder="{{localize "system.sheet.player"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.werewolf.tribe"}}:</label>
      <input type="text" name="systemData.profile.tribe" value="{{system.profile.tribe}}" placeholder="{{localize "system.werewolf.tribe"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.werewolf.pack"}}:</label>
      <input type="text" name="systemData.profile.pack" value="{{system.profile.pack}}" placeholder="{{localize "system.werewolf.pack"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.chronicle"}}:</label>
      <input type="text" name="systemData.profile.chronicle" value="{{system.profile.chronicle}}" placeholder="{{localize "system.sheet.chronicle"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.werewolf.totem"}}:</label>
      <input type="text" name="systemData.profile.totem" value="{{system.profile.totem}}" placeholder="{{localize "system.werewolf.totem"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.werewolf.rank"}}:</label>
      <input type="text" name="systemData.profile.rank" value="{{system.profile.rank}}" placeholder="1" />
    </div>
  </div>
</div>
