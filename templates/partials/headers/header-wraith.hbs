<div class="wod-header-fields">
  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.name"}}:</label>
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize "system.sheet.name"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.wraith.guild"}}:</label>
      <input type="text" name="systemData.profile.guild" value="{{system.profile.guild}}" placeholder="{{localize "system.wraith.guildPlaceholder"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.wraith.legion"}}:</label>
      <input type="text" name="systemData.profile.legion" value="{{system.profile.legion}}" placeholder="{{localize "system.wraith.legionPlaceholder"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.player"}}:</label>
      <input type="text" name="systemData.profile.player" value="{{system.profile.player}}" placeholder="{{localize "system.sheet.player"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.wraith.faction"}}:</label>
      <input type="text" name="systemData.profile.faction" value="{{system.profile.faction}}" placeholder="{{localize "system.wraith.factionPlaceholder"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.wraith.death"}}:</label>
      <input type="text" name="systemData.profile.death" value="{{system.profile.death}}" placeholder="{{localize "system.wraith.deathPlaceholder"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.chronicle"}}:</label>
      <input type="text" name="systemData.profile.chronicle" value="{{system.profile.chronicle}}" placeholder="{{localize "system.sheet.chronicle"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.wraith.regret"}}:</label>
      <input type="text" name="systemData.profile.regret" value="{{system.profile.regret}}" placeholder="{{localize "system.wraith.regretPlaceholder"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.wraith.shadowArchetype"}}:</label>
      <input type="text" name="systemData.shadowArchetype" value="{{system.shadowArchetype}}" placeholder="{{localize "system.wraith.shadowPlaceholder"}}" />
    </div>
  </div>
</div>
