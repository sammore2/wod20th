<div class="wod-header-fields">
  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.name"}}:</label>
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize "system.sheet.name"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.changeling.kith"}}:</label>
      <input type="text" name="systemData.profile.kith" value="{{system.profile.kith}}" placeholder="{{localize "system.changeling.kithPlaceholder"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.changeling.court"}}:</label>
      <input type="text" name="systemData.profile.court" value="{{system.profile.court}}" placeholder="{{localize "system.changeling.courtPlaceholder"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.player"}}:</label>
      <input type="text" name="systemData.profile.player" value="{{system.profile.player}}" placeholder="{{localize "system.sheet.player"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.changeling.seeming"}}:</label>
      <input type="text" name="systemData.profile.seeming" value="{{system.profile.seeming}}" placeholder="{{localize "system.changeling.seemingPlaceholder"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.changeling.house"}}:</label>
      <input type="text" name="systemData.profile.house" value="{{system.profile.house}}" placeholder="{{localize "system.changeling.housePlaceholder"}}" />
    </div>
  </div>

  <div class="wod-field-row">
    <div class="wod-field">
      <label>{{localize "system.sheet.chronicle"}}:</label>
      <input type="text" name="systemData.profile.chronicle" value="{{system.profile.chronicle}}" placeholder="{{localize "system.sheet.chronicle"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.changeling.motley"}}:</label>
      <input type="text" name="systemData.profile.motley" value="{{system.profile.motley}}" placeholder="{{localize "system.changeling.motleyPlaceholder"}}" />
    </div>
    <div class="wod-field">
      <label>{{localize "system.sheet.concept"}}:</label>
      <input type="text" name="systemData.profile.concept" value="{{system.profile.concept}}" placeholder="{{localize "system.sheet.concept"}}" />
    </div>
  </div>
</div>
