<div class="wod-columns-3">
  <!-- COLUNA 1: DISCIPLINAS & RITUAIS -->
  <div class="wod-column">
    <div class="wod-item-header">
      <h4 class="wod-column-header">{{localize "system.sheet.disciplines"}}</h4>
      <button type="button" class="wod-btn-add-discipline" title="Escolher uma disciplina para adicionar ao personagem">+ Disciplina</button>
    </div>

    <!-- ADICIONAR DISCIPLINA: só aparecem as que o personagem possui (pontos > 0) -->
    <!-- ÁRVORE DE DISCIPLINAS DO PERSONAGEM: clique nas bolinhas para o nível; expanda para ver poderes e rolar -->
    <div class="wod-disc-tree-list">
      {{#each disciplineTree}}
      <details class="wod-disc-tree" data-key="{{this.key}}" {{#if this.open}}open{{/if}}>
        <summary class="wod-disc-head">
          <span class="wod-disc-name">{{this.name}}</span>
          <span class="wod-dots-track">
            {{#each this.dotsArr}}
            <button type="button" class="wod-dot {{#if this.filled}}filled{{/if}}" data-path="disciplineRatings.{{../key}}" data-index="{{this.index}}" data-min="0" title="Nível {{this.index}}"></button>
            {{/each}}
          </span>
        </summary>
        <ol class="wod-disc-levels">
          {{#each this.powers}}
          <li class="wod-disc-level {{#if this.active}}active{{else}}locked{{/if}}" title="{{this.description}}">
            <span class="wod-disc-lvl">{{this.level}}</span>
            <span class="wod-disc-pname">{{this.name}}</span>
            <span class="wod-disc-meta">{{this.poolText}} · Dif {{this.difficulty}} · {{this.cost}}</span>
            {{#if this.active}}
            <button type="button" class="wod-roll-tree-power" data-pool="{{this.pool}}" data-diff="{{this.difficulty}}" data-label="{{../name}}: {{this.name}}" title="Rolar {{this.name}} ({{this.pool}} dados)">🎲 {{this.pool}}</button>
            {{/if}}
          </li>
          {{/each}}
        </ol>
      </details>
      {{/each}}
    </div>

    <!-- DISCIPLINAS CUSTOMIZADAS (itens) -->
    <div class="wod-item-header" style="margin-top: 14px;">
      <h4 class="wod-column-header">Customizadas</h4>
      <button type="button" class="wod-btn-add-item" data-type="discipline" title="{{localize "system.sheet.add"}}">{{localize "system.sheet.add"}}</button>
    </div>

    <!-- LISTA DE ITENS DE DISCIPLINAS CUSTOMIZADAS -->
    <div class="wod-trait-list">
      {{#each itemsCategorized.disciplines}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <button type="button" class="wod-roll-item-power" data-id="{{this.id}}" data-name="{{this.name}}" data-level="{{this.level}}" title="Rolar {{this.name}}">
          <i class="fas fa-dice-d10"></i>
        </button>
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}" title="Clique para editar a ficha do poder">{{this.name}}</span>
        <div class="wod-dots-track">
          {{#each this.dots}}
          <span class="wod-item-dot {{#if this.filled}}filled{{/if}}" data-id="{{../id}}" data-index="{{this.index}}"></span>
          {{/each}}
        </div>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.disciplines.length}}
      <div class="wod-empty-msg">{{localize "system.sheet.emptyDisciplines"}}</div>
      {{/unless}}
    </div>

    <!-- RITUAIS -->
    <div class="wod-item-header" style="margin-top: 20px;">
      <h4 class="wod-column-header">{{localize "system.vampire.rituals"}}</h4>
      <button type="button" class="wod-btn-add-item" data-type="ritual" title="{{localize "system.sheet.add"}}">{{localize "system.sheet.add"}}</button>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.rituals}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <button type="button" class="wod-roll-item-power" data-id="{{this.id}}" data-name="{{this.name}}" data-level="{{this.level}}" title="Rolar {{this.name}}">
          <i class="fas fa-dice-d10"></i>
        </button>
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}" title="Clique para editar a ficha do ritual">{{this.name}}</span>
        <div class="wod-dots-track">
          {{#each this.dots}}
          <span class="wod-item-dot {{#if this.filled}}filled{{/if}}" data-id="{{../id}}" data-index="{{this.index}}"></span>
          {{/each}}
        </div>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.rituals.length}}
      <div class="wod-empty-msg">Nenhum ritual cadastrado</div>
      {{/unless}}
    </div>
  </div>

  <!-- COLUNA 2: VIRTUDES, HUMANIDADE & ANTECEDENTES -->
  <div class="wod-column">
    <div class="wod-item-header">
      <h4 class="wod-column-header">{{localize "system.sheet.virtues"}}</h4>
    </div>

    {{#each virtuesList}}
    <div class="wod-trait-row wod-trait-stack">
      <button type="button" class="wod-roll-virtue" data-virtue="{{this.key}}" data-label-key="{{this.labelKey}}" data-val="{{this.value}}" title="Rolar {{localize this.labelKey}}">
        {{localize this.labelKey}}
      </button>
      <div class="wod-dots-track">
        {{#each this.dots}}
        <span class="wod-dot {{#if this.filled}}filled{{/if}}" data-path="{{../path}}" data-index="{{this.index}}" data-min="1"></span>
        {{/each}}
      </div>
    </div>
    {{/each}}

    <!-- AÇÕES RÁPIDAS DE VIRTUDES (FRENESI, RÖTSCHRECK, REMORSO) -->
    <div class="wod-virtue-actions" style="display: flex; flex-direction: column; gap: 4px; margin-top: 8px;">
      <button type="button" class="wod-quick-action-btn wod-roll-frenzy" title="Rolar Autocontrole para Resistir ao Frenesi">
        🔥 Resistir ao Frenesi (Autocontrole)
      </button>
      <button type="button" class="wod-quick-action-btn wod-roll-rotschreck" title="Rolar Coragem para Resistir ao Pânico de Fogo e Sol">
        ☀️ Resistir ao Rötschreck (Coragem)
      </button>
      <button type="button" class="wod-quick-action-btn wod-roll-remorse" title="Rolar Consciência contra Dificuldade 8 para Degeneração">
        ⚖️ Remorso / Degeneração (Dif 8)
      </button>
    </div>

    <!-- HUMANIDADE / TRILHA -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <button type="button" class="wod-roll-humanity wod-column-header-btn" title="Clique para Rolar Humanidade / Acordar de Dia">
        {{localize "system.sheet.humanity"}} 🎲
      </button>
    </div>
    <div class="wod-single-trait">
      <input type="text" name="systemData.humanity.pathName" value="{{system.humanity.pathName}}" placeholder="Humanidade ou Trilha..." class="wod-path-name" />
      <div class="wod-dots-track wod-dots-10">
        {{#each humanityDots}}
        <span class="wod-dot {{#if this.filled}}filled{{/if}}" data-path="humanity" data-index="{{this.index}}" data-min="1"></span>
        {{/each}}
      </div>
    </div>

    <!-- ANTECEDENTES (ITENS) -->
    <div class="wod-item-header" style="margin-top: 20px;">
      <h4 class="wod-column-header">{{localize "system.sheet.backgrounds"}}</h4>
      <button type="button" class="wod-btn-add-item" data-type="background" title="{{localize "system.sheet.add"}}">{{localize "system.sheet.add"}}</button>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.backgrounds}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <button type="button" class="wod-roll-item-power" data-id="{{this.id}}" data-name="{{this.name}}" data-level="{{this.level}}" title="Rolar {{this.name}}">
          <i class="fas fa-dice-d10"></i>
        </button>
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}" title="Editar {{this.name}}">{{this.name}}</span>
        <div class="wod-dots-track">
          {{#each this.dots}}
          <span class="wod-item-dot {{#if this.filled}}filled{{/if}}" data-id="{{../id}}" data-index="{{this.index}}"></span>
          {{/each}}
        </div>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.backgrounds.length}}
      <div class="wod-empty-msg">{{localize "system.sheet.emptyBackgrounds"}}</div>
      {{/unless}}
    </div>

    <!-- QUALIDADES & DEFEITOS -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <h4 class="wod-column-header">{{localize "system.sheet.meritsFlaws"}}</h4>
      <div style="display: flex; gap: 4px;">
        <button type="button" class="wod-btn-add-item" data-type="merit" title="Adicionar Qualidade">+ Qualidade</button>
        <button type="button" class="wod-btn-add-item" data-type="flaw" title="Adicionar Defeito">+ Defeito</button>
      </div>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.meritsFlaws}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}">
          {{#if (eq this.type 'merit')}}🟢{{else}}🔴{{/if}} {{this.name}} ({{this.systemData.cost}} pts)
        </span>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.meritsFlaws.length}}
      <div class="wod-empty-msg">{{localize "system.sheet.emptyMeritsFlaws"}}</div>
      {{/unless}}
    </div>
  </div>

  <!-- COLUNA 3: FORÇA DE VONTADE, PONTOS DE SANGUE E FRAQUEZA -->
  <div class="wod-column">
    <div class="wod-item-header">
      <button type="button" class="wod-roll-willpower wod-column-header-btn" title="Clique para Rolar Força de Vontade Pura">
        {{localize "system.sheet.willpower"}} 🎲
      </button>
    </div>
    <div class="wod-pool-block">
      <label>{{localize "system.sheet.permanent"}} (Base):</label>
      <div class="wod-dots-track wod-dots-10">
        {{#each willpowerDots}}
        <span class="wod-dot {{#if this.filled}}filled{{/if}}" data-path="willpower.max" data-index="{{this.index}}" data-min="1"></span>
        {{/each}}
      </div>

      <label style="margin-top: 12px;">{{localize "system.sheet.temporary"}} (Marcador "✕" = Gasto):</label>
      <div class="wod-boxes-track wod-boxes-10">
        {{#each willpowerBoxes}}
        <span class="wod-box {{#if this.checked}}checked{{/if}}" data-path="willpower" data-index="{{this.index}}" title="Clique para gastar / recuperar"></span>
        {{/each}}
      </div>
    </div>

    <!-- PONTOS DE SANGUE DINÂMICOS POR GERAÇÃO -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <h4 class="wod-column-header">{{localize "system.sheet.blood"}}</h4>
    </div>
    <div class="wod-pool-block">
      <div class="wod-boxes-grid">
        {{#each bloodBoxes}}
        <span class="wod-box {{#if this.checked}}checked{{/if}}" data-path="blood" data-index="{{this.index}}" title="Ponto de Sangue {{this.index}}"></span>
        {{/each}}
      </div>
      <div class="wod-pool-inputs">
        <span>{{localize "system.sheet.current"}}: <input type="number" name="systemData.blood.value" value="{{system.blood.value}}" class="wod-mini-num" /></span>
        <span>{{localize "system.sheet.max"}}: <input type="number" name="systemData.blood.max" value="{{derived.bloodMax}}" class="wod-mini-num" readonly /></span>
        <span>{{localize "system.vampire.bloodPerTurn"}}: <strong>{{derived.bloodPerTurn}}</strong></span>
      </div>
      <div class="wod-quick-actions" style="margin-top: 8px; display: flex; gap: 6px;">
        <button type="button" class="wod-btn-action wod-vampire-heal" title="Gastar 1 sangue para curar 1 dano contundente ou letal">💉 Curar c/ Sangue</button>
        <button type="button" class="wod-btn-action wod-vampire-buff" title="Gastar sangue para aumentar Atributo Físico por uma cena (+1 For/Des/Vig)">🩸 Bombar Atributo</button>
      </div>
    </div>

    <!-- FRAQUEZA DE CLÃ -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <h4 class="wod-column-header">Fraqueza de Clã</h4>
    </div>
    <div class="wod-pool-block">
      <textarea name="systemData.profile.weakness" class="wod-textarea" rows="3" placeholder="Descreva a fraqueza do clã (ex: Nosferatu Aparência 0; Brujah +2 dif frenesi...)">{{system.profile.weakness}}</textarea>
    </div>
  </div>
</div>
