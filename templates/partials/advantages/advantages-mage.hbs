<div class="wod-columns-3">
  <!-- COLUNA 1: ROTES, GRIMÓRIOS & MARAVILHAS -->
  <div class="wod-column">
    <div class="wod-item-header">
      <h4 class="wod-column-header">{{localize "system.mage.rotes"}}</h4>
      <button type="button" class="wod-btn-add-item" data-type="rote" title="{{localize "system.sheet.add"}}">{{localize "system.sheet.add"}}</button>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.rotes}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <button type="button" class="wod-roll-item-power" data-id="{{this.id}}" data-name="{{this.name}}" data-level="{{this.level}}" title="Lançar Efeito Mágico">
          <i class="fas fa-dice-d10"></i>
        </button>
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}">📖 {{this.name}}</span>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.rotes.length}}
      <div class="wod-empty-msg">{{localize "system.mage.emptyRotes"}}</div>
      {{/unless}}
    </div>

    <!-- GRIMÓRIOS -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <h4 class="wod-column-header">{{localize "system.mage.grimoires"}}</h4>
      <button type="button" class="wod-btn-add-item" data-type="grimoire" title="{{localize "system.sheet.add"}}">{{localize "system.sheet.add"}}</button>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.grimoires}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}">📜 {{this.name}}</span>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.grimoires.length}}
      <div class="wod-empty-msg">{{localize "system.mage.emptyGrimoires"}}</div>
      {{/unless}}
    </div>

    <!-- MARAVILHAS & TALISMÃS -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <h4 class="wod-column-header">{{localize "system.mage.wonders"}} & Talismãs</h4>
      <button type="button" class="wod-btn-add-item" data-type="wonder" title="{{localize "system.sheet.add"}}">{{localize "system.sheet.add"}}</button>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.wonders}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}">🔮 {{this.name}} (Arete {{this.systemData.arete}})</span>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.wonders.length}}
      <div class="wod-empty-msg">{{localize "system.mage.emptyWonders"}}</div>
      {{/unless}}
    </div>
  </div>

  <!-- COLUNA 2: ARETE, QUINTESSÊNCIA, PARADOXO & ANTECEDENTES -->
  <div class="wod-column">
    <!-- ARETE -->
    <div class="wod-pool-block">
      <div class="wod-arete-head">
        <label><strong>{{localize "system.mage.arete"}}</strong></label>
        <button type="button" class="wod-btn-add-item wod-roll-arete" title="Rolar Arete Puro">🎲 Rolar</button>
      </div>
      <div class="wod-dots-track wod-dots-10">
        {{#each areteDots}}
        <span class="wod-dot {{#if this.filled}}filled{{/if}}" data-path="arete.value" data-index="{{this.index}}" data-min="1"></span>
        {{/each}}
      </div>
    </div>

    <!-- QUINTESSÊNCIA & PARADOXO -->
    <div class="wod-pool-block" style="margin-top: 10px;">
      <label><strong>{{localize "system.mage.quintessence"}} & {{localize "system.mage.paradox"}}</strong></label>
      <div class="wod-ring">
        <span class="wod-ring-label wod-ring-label-top">Quintessência</span>
        <span class="wod-ring-zero"></span>
        {{#each quintessenceRing}}
        <span class="wod-box wod-ring-slot {{#if this.cancelled}}cancelled{{else if this.quintOn}}quint-on{{else if this.paradoxOn}}paradox-on{{/if}}" data-path="quintessence" data-min="0" data-index="{{this.index}}" style="left: {{this.x}}%; top: {{this.y}}%;" title="Posição {{this.index}}"></span>
        {{/each}}
        <span class="wod-ring-label wod-ring-label-bottom">Paradoxo</span>
      </div>
    </div>

    <!-- ANTECEDENTES -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <h4 class="wod-column-header">{{localize "system.sheet.backgrounds"}}</h4>
      <button type="button" class="wod-btn-add-item" data-type="background" title="{{localize "system.sheet.add"}}">{{localize "system.sheet.add"}}</button>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.backgrounds}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <button type="button" class="wod-roll-item-power" data-id="{{this.id}}" data-name="{{this.name}}" data-level="{{this.level}}" title="Rolar {{this.name}}">
          <i class="fas fa-dice-d10"></i>
        </button>
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}" title="Editar {{this.name}}">{{this.name}}</span>
        <div class="wod-dots-track">
          {{#each this.dots}}
          <span class="wod-item-dot {{#if this.filled}}filled{{/if}}" data-id="{{../id}}" data-index="{{this.index}}"></span>
          {{/each}}
        </div>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.backgrounds.length}}
      <div class="wod-empty-msg">{{localize "system.sheet.emptyBackgrounds"}}</div>
      {{/unless}}
    </div>
  </div>

  <!-- COLUNA 3: FORÇA DE VONTADE, QUALIDADES & DEFEITOS -->
  <div class="wod-column">
    <div class="wod-item-header">
      <button type="button" class="wod-roll-willpower wod-column-header-btn" title="Rolar Força de Vontade">
        {{localize "system.sheet.willpower"}} 🎲
      </button>
    </div>
    <div class="wod-pool-block">
      <label>{{localize "system.sheet.permanent"}}:</label>
      <div class="wod-dots-track wod-dots-10">
        {{#each willpowerDots}}
        <span class="wod-dot {{#if this.filled}}filled{{/if}}" data-path="willpower.max" data-index="{{this.index}}" data-min="1"></span>
        {{/each}}
      </div>

      <label style="margin-top: 12px;">{{localize "system.sheet.temporary"}} (Marcador "✕"):</label>
      <div class="wod-boxes-track wod-boxes-10">
        {{#each willpowerBoxes}}
        <span class="wod-box {{#if this.checked}}checked{{/if}}" data-path="willpower" data-index="{{this.index}}"></span>
        {{/each}}
      </div>
    </div>

    <!-- QUALIDADES & DEFEITOS -->
    <div class="wod-item-header" style="margin-top: 18px;">
      <h4 class="wod-column-header">{{localize "system.sheet.meritsFlaws"}}</h4>
      <div style="display: flex; gap: 4px;">
        <button type="button" class="wod-btn-add-item" data-type="merit" title="Adicionar Qualidade">+ Qualidade</button>
        <button type="button" class="wod-btn-add-item" data-type="flaw" title="Adicionar Defeito">+ Defeito</button>
      </div>
    </div>
    <div class="wod-trait-list">
      {{#each itemsCategorized.meritsFlaws}}
      <div class="wod-trait-row" data-id="{{this.id}}">
        <span class="wod-item-title-clickable" data-action="open-item" data-id="{{this.id}}">
          {{#if (eq this.type 'merit')}}🟢{{else}}🔴{{/if}} {{this.name}} ({{this.systemData.cost}} pts)
        </span>
        <button type="button" class="wod-item-edit-btn" data-action="open-item" data-id="{{this.id}}" title="{{localize "system.sheet.edit"}}">&#9998;</button>
        <button type="button" class="wod-item-delete-btn" data-action="delete-item" data-id="{{this.id}}" title="{{localize "system.sheet.delete"}}">&times;</button>
      </div>
      {{/each}}
      {{#unless itemsCategorized.meritsFlaws.length}}
      <div class="wod-empty-msg">{{localize "system.sheet.emptyMeritsFlaws"}}</div>
      {{/unless}}
    </div>
  </div>
</div>
