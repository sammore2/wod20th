<div class="wod-section">
  <h4 class="wod-column-header">{{localize "system.sheet.history"}}</h4>
  <textarea name="systemData.bio.history" class="wod-textarea" rows="5" placeholder="{{localize "system.sheet.historyPlaceholder"}}">{{system.bio.history}}</textarea>
</div>

<div class="wod-columns-2" style="margin-top: 15px;">
  <div class="wod-column">
    <h4 class="wod-column-header">{{localize "system.sheet.appearance"}}</h4>
    <textarea name="systemData.bio.appearance" class="wod-textarea" rows="4" placeholder="{{localize "system.sheet.appearancePlaceholder"}}">{{system.bio.appearance}}</textarea>
  </div>
  <div class="wod-column">
    <h4 class="wod-column-header">{{localize "system.sheet.contacts"}}</h4>
    <textarea name="systemData.bio.contacts" class="wod-textarea" rows="4" placeholder="{{localize "system.sheet.contactsPlaceholder"}}">{{system.bio.contacts}}</textarea>
  </div>
</div>

<div class="wod-section" style="margin-top: 15px;">
  <h4 class="wod-column-header">{{localize "system.sheet.notes"}}</h4>
  <textarea name="systemData.notes" class="wod-textarea" rows="4" placeholder="{{localize "system.sheet.notesPlaceholder"}}">{{system.notes}}</textarea>
</div>
